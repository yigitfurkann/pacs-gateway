[Unit]
Description=Rclone Remote Control Daemon
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/rclone rcd \
  --rc-addr=0.0.0.0:5572 \
  --rc-user=monitor \
  --rc-pass=1Huawei9 \
  --rc-enable-metrics \
  --rc-web-gui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
